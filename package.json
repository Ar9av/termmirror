{
  "name": "termmirror",
  "version": "0.2.0",
  "description": "MCP server giving AI agents real interactive terminal sessions — PTY, TUIs, REPLs, SSH, even another agent's CLI — with a live web view a human can watch and type into",
  "type": "module",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "claude-code",
    "interactive-terminal",
    "terminal",
    "pty",
    "tty",
    "tui",
    "repl",
    "ai-agent",
    "agent-tools"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ar9av/termmirror.git"
  },
  "bin": {
    "termmirror": "dist/src/index.js"
  },
  "files": [
    "dist/src",
    "public",
    "scripts"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/index.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "postinstall": "node scripts/fix-pty-permissions.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@xterm/headless": "^5.5.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.0.0",
    "playwright-core": "^1.63.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.0"
  }
}
